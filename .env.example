# Application
NODE_ENV=development
PORT=3000

# Database
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?[options]
# Example: postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
# Supabase Connection
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=

# Meta Platform
# App Secret from the Meta app dashboard (App settings > Basic). This signs
# every inbound webhook: if it does not match, the signature guard rejects all
# delivery, read and reply callbacks and verifications appear stuck at `sent`.
META_APP_SECRET=

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=
SHOPIFY_SCOPES=
SHOPIFY_API_VERSION=2026-01
# Enables CLI-created test orders to enter the normal webhook pipeline locally.
SHOPIFY_PROCESS_TEST_ORDERS=true
SHOPIFY_BILLING_REQUIRED=true
SHOPIFY_BILLING_SKIP_CUSTOM_APP_ERROR=true
SHOPIFY_BILLING_PLAN_NAME=Akeed Pro
SHOPIFY_BILLING_PRICE=19
SHOPIFY_BILLING_CURRENCY=USD
SHOPIFY_BILLING_TEST_MODE=true

# Frontend
FRONTEND_DASHBOARD_URL=

# Recoverable webhook dispatch (enable only after the dry-run inventory)
REDIS_URL=redis://localhost:6379
WEBHOOK_RECONCILIATION_ENABLED=false
WEBHOOK_RECONCILIATION_DRY_RUN=false
WEBHOOK_RECONCILIATION_INTERVAL_MS=15000
WEBHOOK_RECONCILIATION_BATCH_SIZE=25
WEBHOOK_DISPATCH_MAX_ATTEMPTS=8
WEBHOOK_DISPATCH_LEASE_MS=30000
WEBHOOK_PROCESSING_STALE_MS=600000
# Age an accepted order must reach before the order-level backstop re-drives it
# when it still has no verification. Keep it above a normal dispatch round-trip
# so in-flight orders are never touched.
WEBHOOK_ORPHAN_ORDER_GRACE_MS=120000

# Admin Control Tower (keep disabled until staff metadata and MFA are provisioned)
ADMIN_CONTROL_TOWER_ENABLED=false
ADMIN_REQUIRE_AAL2=true
# Staff billing writes (adjust, resolve, inquire, provider evidence, repair).
# When true, name the operators by Supabase user id, comma-separated.
STANDALONE_BILLING_OPERATIONS_ENABLED=false
STANDALONE_BILLING_OPERATOR_IDS=
ADMIN_HEALTH_ONBOARDING_ATTENTION_HOURS=24
ADMIN_HEALTH_ONBOARDING_CRITICAL_HOURS=72
ADMIN_HEALTH_NO_ORDER_ATTENTION_HOURS=168
ADMIN_HEALTH_NO_ORDER_CRITICAL_HOURS=336
ADMIN_HEALTH_USAGE_ATTENTION=80
ADMIN_HEALTH_USAGE_CRITICAL=95
ADMIN_HEALTH_FAILURE_ATTENTION_RATE=20
ADMIN_HEALTH_FAILURE_ATTENTION_MINIMUM=10
ADMIN_HEALTH_FAILURE_CRITICAL_RATE=40
ADMIN_HEALTH_FAILURE_CRITICAL_MINIMUM=20
ADMIN_HEALTH_WEBHOOK_ATTENTION_COUNT=1
ADMIN_HEALTH_WEBHOOK_CRITICAL_COUNT=3
ADMIN_HEALTH_INACTIVE_ATTENTION_HOURS=168
ADMIN_HEALTH_INACTIVE_CRITICAL_HOURS=336

# Standalone prepaid credit billing (Paymob, Egypt)
# Leave STANDALONE_CREDIT_BILLING_ENABLED=false to deploy dark: Standalone
# sources keep the periodic plan they shipped with and no PAYMOB_* value is read.
# Setting it to true makes every PAYMOB_* variable below required and validated
# at startup; a placeholder value aborts boot rather than reaching a payment.
STANDALONE_CREDIT_BILLING_ENABLED=false
STANDALONE_CREDIT_PRICE_MINOR=200
STANDALONE_FREE_GRANT=30
STANDALONE_PURCHASE_MIN=100
STANDALONE_PURCHASE_MAX=5000
STANDALONE_PURCHASE_STEP=50
STANDALONE_LOW_BALANCE_THRESHOLD=10

# Billing integrity reconciliation. Local invariant, settlement, metric, and
# health checks always run. The first switch controls only scheduled Paymob
# inquiries; report-only prevents canonical credit/payment mutations.
STANDALONE_BILLING_SCHEDULED_INQUIRY_ENABLED=false
STANDALONE_BILLING_RECONCILIATION_REPORT_ONLY=true
STANDALONE_BILLING_RECONCILIATION_CRON=30 2 * * *
STANDALONE_BILLING_RECONCILIATION_TIMEZONE=Africa/Cairo
STANDALONE_BILLING_RECONCILIATION_BATCH_SIZE=50
STANDALONE_BILLING_RECONCILIATION_LOOKBACK_DAYS=7
STANDALONE_BILLING_STALE_PENDING_MINUTES=30
STANDALONE_BILLING_BACKLOG_ALERT_COUNT=25
STANDALONE_BILLING_BACKLOG_ALERT_AGE_MINUTES=120
STANDALONE_BILLING_PAYMOB_SLOW_MS=5000
STANDALONE_BILLING_PAYMOB_ERROR_RATE_PERCENT=20
STANDALONE_BILLING_PAYMOB_ERROR_RATE_MIN_ATTEMPTS=5

# test | live. Must agree with any test/live marker inside the keys below.
PAYMOB_MODE=test
PAYMOB_BASE_URL=
# Path must be exactly /api/webhooks/payments/paymob
PAYMOB_CALLBACK_URL=
PAYMOB_RETURN_URL=
# Server-only. Never expose these to the browser or write them to a log.
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
# Sent to the browser as part of the hosted checkout URL.
PAYMOB_PUBLIC_KEY=
# Separate integrations; card and mobile wallet must differ. In test mode the
# wallet id may stay empty (card-only sandbox); live requires both.
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_CHECKOUT_EXPIRATION_SECONDS=900
