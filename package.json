{
  "name": "akeed-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "db:pull": "drizzle-kit introspect",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "node dist/infrastructure/database/migrate.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "log:check": "node scripts/check-structured-logs.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:contract:entitlements": "jest --config ./test/jest-entitlement-contract.json --runInBand",
    "test:contract:source-identity": "jest --config ./test/jest-source-identity-contract.json --runInBand",
    "test:contract:shopify": "jest --config ./test/jest-shopify-contract.json --runInBand",
    "test:contract:platform-boundary-migration": "jest --config ./test/jest-platform-boundary-migration-contract.json --runInBand",
    "test:contract:standalone-provisioning": "jest --config ./test/jest-standalone-provisioning-contract.json --runInBand",
    "test:contract:standalone-approval": "jest --config ./test/jest-standalone-approval-contract.json --runInBand",
    "test:contract:manual-orders": "jest --config ./test/jest-manual-order-ingestion-contract.json --runInBand",
    "test:contract:paymob-checkout": "jest --config ./test/jest-paymob-checkout-contract.json --runInBand",
    "test:contract:credit-usage": "jest --config ./test/jest-credit-usage-contract.json --runInBand",
    "test:contract:billing-operations": "jest --config ./test/jest-standalone-billing-operations-contract.json --runInBand",
    "test:acceptance:e04": "jest --config ./test/jest-e04-acceptance.json --runInBand",
    "test:core:platform-neutral": "jest --runInBand src/modules/verification-core src/modules/commerce-outcomes",
    "test:gate:e02": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-e02-release-gate.ps1",
    "test:gate:e03": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-e03-release-gate.ps1",
    "test:gate:e04": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-e04-release-gate.ps1",
    "shopify:test-cod": "tsx scripts/shopify/create-cod-test-order.ts",
    "test:contract:credit-foundation": "jest --config ./test/jest-credit-foundation-contract.json --runInBand"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/throttler": "^6.5.0",
    "@supabase/supabase-js": "^2.93.1",
    "axios": "^1.13.5",
    "bullmq": "^5.70.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "google-libphonenumber": "^3.2.42",
    "postgres": "^3.4.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.6",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.5",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^1.7.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
